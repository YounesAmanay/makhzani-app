# Server Configuration
PORT=3000
NODE_ENV=production

# Database Configuration (AWS RDS)
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=3306
DB_NAME=makhzani_db
DB_USER=admin
DB_PASSWORD=your_db_password

# JWT Configuration
JWT_SECRET=generate_a_long_random_secret_here
JWT_EXPIRES_IN=7d

# AWS S3 — file storage (product images, avatars, PDFs)
AWS_REGION=eu-west-3
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_S3_BUCKET=makhzani-uploads

# Firebase Admin SDK — push notifications
# Place firebase-service-account.json in config/ (never commit it)

# Redis (optional — falls back to in-memory if not set)
# REDIS_URL=redis://localhost:6379

# Twilio SMS — OTP delivery
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+16617443726

# API Keys
API_KEY=your_api_key_here
